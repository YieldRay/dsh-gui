{
  "name": "dsh-gui",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno desktop -A --unstable-raw-imports --hmr main.ts",
    "build": "deno desktop -A --unstable-raw-imports --output DSH.app main.ts",
    "test": "deno test -A --unstable-raw-imports src/"
  },
  "desktop": {
    "app": {
      "name": "DeepSeek",
      "identifier": "ai.deepseek.dsh-gui",
      "icons": {
        "macos": [
          { "path": "./assets/icon-16.png", "size": 16 },
          { "path": "./assets/icon-32.png", "size": 32 },
          { "path": "./assets/icon-128.png", "size": 128 },
          { "path": "./assets/icon-256.png", "size": 256 },
          { "path": "./assets/icon-512.png", "size": 512 }
        ],
        "linux": "./assets/icon-512.png"
      }
    },
    "backend": "webview"
  },
  "unstable": ["raw-imports"],
  "fmt": {
    "semiColons": true,
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@npmcli/arborist": "npm:@npmcli/arborist@^10.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/tar": "jsr:@std/tar@^0.1.10",
    "@types/npmcli__arborist": "npm:@types/npmcli__arborist@^6.3.3"
  }
}
